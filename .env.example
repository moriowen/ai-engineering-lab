# Copy to .env and fill in only what you use. Never commit .env.

# Model providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# Local serving (vLLM / Ollama / llama.cpp OpenAI-compatible endpoint)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1

# Embeddings / vector store
EMBEDDING_MODEL=
VECTOR_DB_URL=

# Observability
TRACING_ENDPOINT=

# Paths
LAB_DATA_DIR=./data
LAB_RESULTS_DIR=./results
